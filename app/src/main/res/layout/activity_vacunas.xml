<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vacunasRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical"
    tools:context=".VacunasActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloVacunas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Módulo de Vacunas"
            android:textColor="#0D47A1"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloVacunas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Historial de vacunación de tus mascotas. Toca una vacuna para ver su detalle."
            android:textColor="#555555"
            android:textSize="15sp" />

        <ListView
            android:id="@+id/lvVacunas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvVacunasVacio"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="16dp"
            android:text="Aún no hay vacunas registradas.\nToca «Agregar vacuna» para registrar la primera."
            android:textColor="#555555"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAgregarVacunaLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#1565C0"
            android:text="Agregar vacuna"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mascotasRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pata_background"
    android:orientation="vertical"
    tools:context=".MascotasActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">


    <!-- Encabezado de la pantalla -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Icono Mascotas"
            android:src="@drawable/ic_paw" />

        <TextView
            android:id="@+id/tvTituloMascotas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Listado de Mascotas"
            android:textColor="@color/pata_primary_dark"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSubtituloMascotas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Selecciona una mascota de la lista para ver su detalle, editarla o eliminarla."
        android:textColor="@color/pata_text_secondary"
        android:textSize="14sp" />

    <!-- Mensaje cuando no hay registros -->
    <TextView
        android:id="@+id/tvSinMascotas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="@color/pata_primary_light"
        android:gravity="center"
        android:padding="20dp"
        android:text="Aún no hay mascotas registradas.\nPresiona 'Agregar Mascota' para crear el primer expediente."
        android:textColor="@color/pata_primary"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- ListView para mostrar los registros de mascotas desde SQLite -->
    <ListView
        android:id="@+id/lvMascotas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:divider="#C8E6C9"
        android:dividerHeight="1dp"
        android:padding="4dp" />

    <!-- Botones de acción principales -->
    <Button
        android:id="@+id/btnIrAgregarMascota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/pata_primary"
        android:padding="12dp"
        android:text="+ Agregar Mascota"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />


    </LinearLayout>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>

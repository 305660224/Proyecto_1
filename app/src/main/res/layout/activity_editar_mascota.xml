<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pata_background"
    android:fillViewport="true"
    tools:context=".EditarMascotaActivity">

    <LinearLayout
        android:id="@+id/editarMascotaRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Encabezado del Formulario de Edición -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Icono Editar Mascota"
                android:src="@drawable/ic_paw" />

            <TextView
                android:id="@+id/tvTituloEditarMascota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Editar Mascota"
                android:textColor="@color/pata_primary_dark"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubtituloEditarMascota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Modifica la información de la mascota seleccionada y presiona 'Guardar Cambios'."
            android:textColor="@color/pata_text_secondary"
            android:textSize="14sp" />

        <!-- Contenedor del Formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/pata_primary_light"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Campo: Nombre (*) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de la mascota (*)"
                android:textColor="@color/pata_primary_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditarNombreMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ej. Max, Luna, Michi"
                android:inputType="textCapWords|textPersonName"
                android:padding="10dp" />

            <!-- Campo: Especie (*) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Especie (*)"
                android:textColor="@color/pata_primary_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditarEspecieMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ej. Perro, Gato, Conejo, Ave"
                android:inputType="textCapWords"
                android:padding="10dp" />

            <!-- Campo: Edad (*) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edad en años (*)"
                android:textColor="@color/pata_primary_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditarEdadMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ej. 3"
                android:inputType="number"
                android:padding="10dp" />

            <!-- Campo: Peso -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peso en kilogramos (kg)"
                android:textColor="@color/pata_primary_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditarPesoMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ej. 12.5"
                android:inputType="numberDecimal"
                android:padding="10dp" />

            <!-- Campo: Notas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notas u observaciones"
                android:textColor="@color/pata_primary_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditarNotasMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/edit_text"
                android:gravity="top|start"
                android:hint="Alergias, raza, dieta especial, comportamiento..."
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="10dp" />

        </LinearLayout>

        <!-- Botón Guardar Cambios -->
        <Button
            android:id="@+id/btnGuardarCambiosMascota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/pata_primary"
            android:padding="12dp"
            android:text="Guardar Cambios"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Botón Cancelar -->
        <Button
            android:id="@+id/btnCancelarEditarMascota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#757575"
            android:text="Cancelar"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>

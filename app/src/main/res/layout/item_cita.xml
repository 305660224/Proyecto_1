<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFF3E0"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemCitaMotivo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#BF360C"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Control anual" />

        <TextView
            android:id="@+id/tvItemCitaEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Próxima" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvItemCitaFechaHora"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#555555"
        android:textSize="14sp"
        tools:text="20/11/2026 a las 10:30" />

    <TextView
        android:id="@+id/tvItemCitaVeterinaria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#555555"
        android:textSize="14sp"
        tools:text="Veterinaria San Francisco" />
</LinearLayout>

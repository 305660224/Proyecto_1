<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/citasRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical"
    tools:context=".CitasActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloCitas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agenda de Citas"
            android:textColor="#BF360C"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloCitas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Citas veterinarias de tus mascotas. Toca una cita para ver su detalle."
            android:textColor="#555555"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvResumenCitas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:textColor="#BF360C"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Tienes 2 citas próximas." />

        <ListView
            android:id="@+id/lvCitas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvCitasVacio"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="16dp"
            android:text="Aún no hay citas agendadas.\nToca «Agendar cita» para registrar la primera."
            android:textColor="#555555"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAgregarCitaLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#BF360C"
            android:text="Agendar cita"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
